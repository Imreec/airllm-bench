# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real tokens. Only this example is committed.
#
# KEYLESS BY DEFAULT (D8): nothing here is needed to run the Tier-1 analysis suite,
# the structural evals, the figures, or `scripts/self_grade.py` — all keyless and offline.
# HF_TOKEN is needed ONLY for the hardware-bound model downloads (Tier-2), and only for
# gated models or to lift anonymous rate limits. Qwen2.5 is openly licensed, so it may not
# be strictly required — set it if downloads are rate-limited.

# Hugging Face token — model downloads (Tier-2 only). Create at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: there is NO LLM-provider or OpenRouter key here by design. The economic analysis
# uses documented price constants in config/economics.json (no live pricing pull, no API
# inference calls). See docs/PRD.md D8 and the Gatekeeper-N/A ADR.
