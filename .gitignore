*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
MANIFEST

# Virtual environment (uv)
.venv/
venv/
env/

# uv.lock IS committed — it pins exact dependency versions for reproducibility

# Runtime logs
logs/
*.log

# NOTE: results/ and figures/ ARE committed in HW5 — the raw JSON is the source of truth
# and figures are embedded in the README. Only scratch/large intermediates are ignored.
results/scratch/
figures/scratch/

# Spike run outputs — throwaway go/no-go artifacts
spike/out/

# IDE & OS junk
