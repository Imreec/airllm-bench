.coverage
.coverage.*
htmlcov/
coverage.xml

# Ruff & mypy caches
.ruff_cache/
.mypy_cache/

# Temporary / scratch files
tmp/
scratch/
*.tmp

# Claude Code worktrees — parallel sessions live here, never commit them
.claude/worktrees/

# Claude Code per-machine state — NEVER commit (absolute paths / usernames leak).
