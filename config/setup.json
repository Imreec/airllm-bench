  "cold_flush": {
    "_note": "EmptyStandbyList.exe (Sysinternals RAMMap companion) flushes the Windows Standby List; needs Administrator. min_rise_mb = the least freed memory that proves a real cold cache.",
    "command": ["C:/tools/EmptyStandbyList.exe", "standbylist"],
    "min_rise_mb": 2000
  }
